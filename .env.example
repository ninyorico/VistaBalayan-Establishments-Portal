VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Gemini is server-only. Configure GEMINI_API_KEY in Vercel/server env.
GEMINI_API_KEY=your-gemini-api-key
GEOAPIFY_API_KEY=your-geoapify-api-key

# Server-only variables for Vercel /api functions.
# Do not expose these with VITE_ prefixes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OTP_HASH_SECRET=replace-with-a-long-random-secret
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_PRIVATE_KEY=your-emailjs-private-key
EMAILJS_FROM_NAME=VistaBalayan
